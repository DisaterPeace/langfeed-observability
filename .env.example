# ============================================================================
# Template for .env — copy to `.env` and fill in real generated secrets.
#   cp .env.example .env
# Generate secrets with:
#   openssl rand -hex 32   (ENCRYPTION_KEY, NEXTAUTH_SECRET)
#   openssl rand -hex 16   (SALT, REDIS_AUTH, MINIO_ROOT_PASSWORD)
# Generate a Langfuse key pair with:
#   python -c "import uuid;print('pk-lf-'+str(uuid.uuid4()));print('sk-lf-'+str(uuid.uuid4()))"
# ============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

REDIS_AUTH=CHANGEME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS
SALT=CHANGEME
NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://localhost:3000

LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9190
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9190

# Grafana admin login (defaults to admin/admin if unset; set a real password)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGEME

LANGFUSE_INIT_ORG_ID=agent-service-org
LANGFUSE_INIT_ORG_NAME=agent-service
LANGFUSE_INIT_PROJECT_ID=agent-service
LANGFUSE_INIT_PROJECT_NAME=agent-service
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

LANGFUSE_HOST=http://localhost:3000

# --- Per-owner Langfuse projects (multi-owner mirror) -----------------------
# Each agent owner has its OWN Langfuse project. On OSS, create the two projects
# in the Langfuse UI at onboarding (Org -> New project -> Settings -> API Keys),
# then paste their key pairs here. Each owner's code uses only its own pair.
LANGFUSE_REPO_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_REPO_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_BUG_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_BUG_SECRET_KEY=sk-lf-CHANGEME

# --- OTLP transport auth (stream 1) -----------------------------------------
# The collector requires this bearer token on incoming OTLP (openssl rand -hex 24).
# %20 encodes the space ("Bearer <token>") — the OTel SDK URL-decodes header values.
OTLP_BEARER_TOKEN=CHANGEME
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20CHANGEME

# --- Observability contract: mandatory resource attributes ------------------
# Resource.create() reads OTEL_RESOURCE_ATTRIBUTES automatically; these ride on
# every OTel signal. service.name here is a base value: each identity OVERRIDES it
# in code with its own id (agent-orchestrator / repo-analyzer / bug-detector) and
# adds agent.id, so every signal is attributable to its owner. service.version and
# deployment.environment are shared. DEPLOYMENT_ENV also sets the Langfuse environment.
OTEL_RESOURCE_ATTRIBUTES=service.name=agent-service,service.version=0.1.0,deployment.environment=dev
DEPLOYMENT_ENV=dev

# --- LLM provider: Ollama Cloud (free tier) ---------------------------------
# Get a key at https://ollama.com -> Settings -> API Keys. Omit to run in MOCK
# mode (no real calls, canned reply, still exercises the full trace/metrics pipeline).
OLLAMA_API_KEY=CHANGEME
LLM_MODEL=gpt-oss:20b
